NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://mimi:mimi_dev_password@localhost:5432/mimi_store
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-before-seeding

# MTN MoMo Collections (leave MOMO_ENABLED=false until approved production values are set)
MOMO_ENABLED=false
MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=mtnrwanda
MOMO_CURRENCY=RWF
MOMO_CALLBACK_URL=https://api.example.com/api/v1/payments/momo/callback
